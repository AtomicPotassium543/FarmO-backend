# Application
APP_NAME=Farmo API
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True

# Server
HOST=127.0.0.1
PORT=8000

# Database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/FarmO

# JWT Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Password Security
PASSWORD_HASH_ALGORITHM=argon2

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Farmo

# Email Verification
EMAIL_VERIFICATION_EXPIRE_MINUTES=30

# Password Reset
PASSWORD_RESET_EXPIRE_MINUTES=15

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173